{
  "version": 1,
  "status": "adopted",
  "length_unit": "output_height_fraction",
  "dimensionless_fields": [
    "opacity",
    "fill_opacity",
    "unoccupied_area_target"
  ],
  "font_family_mapping": {
    "sans": "Noto Sans SC",
    "serif": "Noto Serif SC",
    "kai": "LXGW WenKai",
    "hand": "Ma Shan Zheng"
  },
  "families": [
    {
      "id": "atlas-tint",
      "name": "01 古典地图集淡彩／铜版",
      "status": "adopted",
      "purpose": "适合西伯利亚／东欧的区域总览：淡色面、纤细河网、衬线地名。铜版纹理只取语言，不照抄繁密装饰。",
      "theme_mapping": "archival",
      "palette": {
        "background": "#f3ecd9",
        "land": "#e5d4aa",
        "water": "#63869a",
        "ink": "#27261f",
        "boundary": "#96664f",
        "accent": "#ad4c38"
      },
      "lines": {
        "river_major": {
          "stroke": "#63869a",
          "width": 0.0015,
          "dash": "none"
        },
        "river_minor": {
          "stroke": "#63869a",
          "width": 0.0008,
          "dash": "none"
        },
        "coast": {
          "stroke": "#27261f",
          "width": 0.0012,
          "dash": "none"
        },
        "border_confirmed": {
          "stroke": "#96664f",
          "width": 0.0013,
          "dash": "none"
        },
        "border_uncertain": {
          "stroke": "#96664f",
          "width": 0.0011,
          "dash": "dash"
        },
        "regions": {
          "fill": "#e5d4aa",
          "fill_opacity": 0.23,
          "stroke": "#96664f",
          "stroke_width": 0.0011,
          "dash": "none"
        },
        "routes": {
          "stroke": "#ad4c38",
          "width": 0.0028,
          "dash": "dash",
          "arrow_start": false,
          "arrow_end": true
        },
        "defense_wall": {
          "stroke": "#ad4c38",
          "width": 0.003,
          "dash": "none",
          "arrow_start": false,
          "arrow_end": false
        }
      },
      "markers": {
        "capital": {
          "dot_radius": 0.006,
          "color": "#ad4c38",
          "stroke": "#f3ecd9",
          "stroke_width": 0.0015
        },
        "city": {
          "dot_radius": 0.004,
          "color": "#27261f",
          "stroke": "#f3ecd9",
          "stroke_width": 0.0012
        },
        "settlement": {
          "dot_radius": 0.0026,
          "color": "#27261f",
          "stroke": "#f3ecd9",
          "stroke_width": 0.001
        }
      },
      "labels": {
        "title": {
          "font": "serif",
          "size": 0.046,
          "color": "#27261f",
          "bold": true,
          "italic": false
        },
        "region": {
          "font": "serif",
          "size": 0.033,
          "color": "#27261f",
          "bold": false,
          "italic": false
        },
        "city": {
          "font": "serif",
          "size": 0.024,
          "color": "#27261f",
          "bold": false,
          "italic": false
        },
        "river": {
          "font": "serif",
          "size": 0.023,
          "color": "#63869a",
          "bold": false,
          "italic": true
        }
      },
      "halo": {
        "width": 0.0022,
        "color": "#f3ecd9"
      },
      "layout": {
        "safe_margins": {
          "top": 0.065,
          "right": 0.065,
          "bottom": 0.075,
          "left": 0.065
        },
        "title_reserved_height": 0.1,
        "legend_reserved_height": 0.07,
        "minimum_label_gap": 0.012,
        "minimum_label_marker_gap": 0.008,
        "unoccupied_area_target": 0.22
      },
      "optional": {
        "legend": {
          "enabled": true,
          "font": "sans",
          "size": 0.019,
          "swatch_width": 0.032,
          "row_gap": 0.028
        },
        "scale_bar": {
          "enabled": false,
          "width": 0.18,
          "stroke_width": 0.0012,
          "font": "sans",
          "size": 0.018,
          "requires": "已核验投影与比例尺；本页虚构示意不显示距离"
        },
        "graticule": {
          "enabled": false,
          "stroke": "#96664f",
          "width": 0.0005,
          "dash": "dot",
          "opacity": 0.35,
          "requires": "已核验投影；经纬度间隔按地图范围选定"
        }
      },
      "implementation_notes": [
        "所有线宽、字号、点半径、间距、边距与尺寸均为 output_height_fraction；像素 = 数值 × 输出高度 H。",
        "颜色是 #rrggbb；font 键映射到顶层 font_family_mapping。河名 italic=true；中文字体未必有真斜体，合成斜体仅为草案。",
        "dash 沿用 LayerDoc 的 none/dash/dot；本页 SVG 示意用 dash=6w,4w 与 dot=w,3w（w=当前线宽）展示，不改变现有渲染器。",
        "此 JSON 是已采纳的风格主题配方（Issue #99 Q4，2026-11-14）：仅决定样式默认值，几何、锚点和来源仍由地图工作室验证。",
        "不从老图复用其地理位置／疆域结论；它们是视觉参考，不是历史准确性证明。"
      ],
      "preview": "atlas-tint.jpg"
    },
